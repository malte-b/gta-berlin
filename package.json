{
  "name": "gta-berlin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "bench": "node scripts/bench.ts",
    "bench:games": "node scripts/games-bench.ts",
    "check": "node scripts/check.ts",
    "test:bridges": "node scripts/test-bridges.ts",
    "check:crossings": "node scripts/crossings.ts",
    "db:schema": "node --env-file-if-exists=.env scripts/db-schema.ts",
    "db:token": "node --env-file-if-exists=.env scripts/hasura-jwt.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.169.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "nipplejs": "^1.0.4",
    "three": "^0.169.0"
  }
}
