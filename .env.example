# The shared high score board (README, "Scores"): Postgres on the Datahub,
# reached through its Hasura GraphQL API. Also set in Vercel's environment
# variables. Never commit the real values.
HASURA_URL=https://backend-api.data-hub.berlin
# The API signs in with one of these: a JWT for the berlin_game role
# (npm run db:token writes it, signed with HASURA_JWT_KEY, the HS256 key in
# the Hasura server's HASURA_GRAPHQL_JWT_SECRET; only needed for that) ...
HASURA_TOKEN=
HASURA_JWT_KEY=
# ... or the admin secret, acting as HASURA_ROLE. npm run db:schema needs it.
HASURA_ADMIN_SECRET=
HASURA_ROLE=berlin_game
# The Postgres database's name in Hasura, for npm run db:schema.
HASURA_SOURCE=default
